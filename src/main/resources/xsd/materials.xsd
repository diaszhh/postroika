<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://postroika.example.com/soap/materials"
        xmlns:tns="http://postroika.example.com/soap/materials"
        elementFormDefault="qualified">

    <xs:element name="CheckMaterialAvailabilityRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="materialId" type="xs:long"/>
                <xs:element name="requestedQuantity" type="xs:decimal"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CheckMaterialAvailabilityResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="materialId" type="xs:long"/>
                <xs:element name="name" type="xs:string" minOccurs="0"/>
                <xs:element name="unit" type="xs:string" minOccurs="0"/>
                <xs:element name="requestedQuantity" type="xs:decimal"/>
                <xs:element name="availableQuantity" type="xs:decimal"/>
                <xs:element name="available" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>